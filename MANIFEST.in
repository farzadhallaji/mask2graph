include LICENSE README.md CHANGELOG.md CITATION.cff CONTRIBUTING.md CONFIG_POLICY.md IMPLEMENTATION_RULES.md RELEASE.md
recursive-include configs *.yaml *.md
recursive-include docs *.md
recursive-include examples *.py
recursive-include notebooks *.md *.ipynb *.gif
recursive-include scripts *.py
recursive-include tests *.py
prune **/__pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
